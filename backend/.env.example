APP_ENV=local
APP_DEBUG=true
TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unified_pos
DB_USER=root
DB_PASS=Mysql@1234

JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPPING_PROVIDER=mock
SHIPPING_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_NAME=adams:push_queue
REDIS_TIMEOUT=1.5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

IMAGE_MAIN_TARGET_KB=100
IMAGE_THUMB_TARGET_KB=30

# Cloudflare R2 image storage (product/category/brand/banner images).
# When false, images are saved to backend/public/uploads instead.
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Storefront SEO (canonical URLs, sitemap.xml, Google Merchant feed)
SITE_URL=https://shopadams.in
SITE_NAME=
ASSET_URL=
SEO_AREA=India

# Delivery Management: shop location (Tenkasi, Melagaram) — used as the
# distance-calculation origin for the within-radius/beyond-radius delivery
# decision. Never hardcode these elsewhere; always read via Config::get().
SHOP_LAT=
SHOP_LNG=

# WhatsApp Business Cloud API (Meta) — used to notify a customer when a
# beyond-radius order's India Post tracking ID is saved. Leave blank to
# fall back to a manual "Send via WhatsApp" click-to-chat (wa.me) button
# in the admin Deliveries screen instead of an automatic API send.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=order_tracking_update
WHATSAPP_TEMPLATE_LANGUAGE=en
