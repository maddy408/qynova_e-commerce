# Storefront on Apache / cPanel / Hostinger. Upload the whole `dist/` folder
# (this file, index.php, seo.config.php, index.html, assets/) to the web root.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let an /api path on this domain (if you host the API here) pass through untouched.
    RewriteRule ^api(/|$) - [L]

    # SEO files served on the storefront domain (generated by the API).
    RewriteRule ^robots\.txt$ index.php?__seo=robots.txt [L,QSA]
    RewriteRule ^sitemap\.xml$ index.php?__seo=sitemap.xml [L,QSA]
    RewriteRule ^(sitemap-[a-z0-9-]+\.xml)$ index.php?__seo=$1 [L,QSA]
    RewriteRule ^feeds/google-merchant\.xml$ index.php?__seo=google-merchant.xml [L,QSA]

    # Never serve the raw shell directly - always go through the SEO entry.
    RewriteRule ^index\.html$ / [R=301,L]

    # Every app route (/product/..., /category/..., ...) -> index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Don't expose the config file's source.
<Files "seo.config.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    # Vite's hashed bundles never change - cache for a year.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
