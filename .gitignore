# Env files — never commit secrets
.env
.env.local
.env.test
**/.env
**/.env.local
**/.env.test

# Storage & Cache
backend/storage/cache/
**/storage/cache/
backend/storage/

# Test artifacts
test_artifacts/
test-results/
playwright-report/
scratch/

# Dependencies and build output (apps/* also carry their own .gitignore)
node_modules/
**/node_modules/
vendor/
**/vendor/
*.phar
**/composer.phar
dist/
dist-ssr/
.next/
out/
build/

# Backend uploads (user-generated content)
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Firebase service account / secrets
*firebase-service-account*.json

# Logs
*.log

# Scratch scripts
scratch/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
